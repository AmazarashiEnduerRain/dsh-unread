{
  "name": "dsh-unread",
  "version": "1.0.0",
  "type": "module",
  "description": "Codex-style unread sessions for DeepSeek Harness: a Windows taskbar overlay badge when a session run completes or an approval is pending, plus mark-as-read / mark-as-unread and an unread dot in the sidebar.",
  "license": "MIT",
  "author": "AmazarashiEnduerRain",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmazarashiEnduerRain/dsh-unread"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "unread",
    "badge",
    "notification",
    "taskbar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.ico",
    "README.md"
  ],
  "dependencies": {
    "koffi": "^3.1.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
